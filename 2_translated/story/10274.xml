      <EnglishText>Eles teriam aguentado os ataques dos
soldados e continuariam lutando se
estivessem com nossas armaduras.</EnglishText>
      <Notes/>
      <SpeakerId>3</SpeakerId>
      <Id>42</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>3673</PointerOffset>
