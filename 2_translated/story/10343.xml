    <Entry>
      <PointerOffset>588</PointerOffset>
      <JapaneseText>ヘンな音、お外から
聞こえるけど
出たらいけないの……
</JapaneseText>
      <EnglishText>Que barulho estranho! Dá pra
ouvir lá de fora, mas eu não
posso sair...</EnglishText>
      <Notes/>
      <SpeakerId>0</SpeakerId>
      <Id>3</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>610</PointerOffset>
      <JapaneseText>つまんないなぁ……
</JapaneseText>
      <EnglishText>Que tédio...</EnglishText>
      <Notes/>
      <SpeakerId>0</SpeakerId>
      <Id>4</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>648</PointerOffset>
      <JapaneseText>私、ガジュマさんとは
お話しないの……
</JapaneseText>
      <EnglishText>Eu não posso falar
com Gajuma, moço...</EnglishText>
      <Notes/>
      <SpeakerId>0</SpeakerId>
      <Id>5</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>673</PointerOffset>
      <JapaneseText>お外でお魚さんを
見たいのに……
どうして出ちゃダメなの？</JapaneseText>
      <EnglishText>Eu quero ver os
peixinhos... Por que não
posso sair?</EnglishText>
      <Notes/>
      <SpeakerId>0</SpeakerId>
      <Id>6</Id>
      <Status>Proofreading</Status>
    </Entry>
