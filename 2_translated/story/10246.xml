      <Notes/>
      <SpeakerId>13</SpeakerId>
      <Id>49</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>2313</PointerOffset>
      <JapaneseText>いつも仲良くしとったじいさんも、
冷たくあたりよる……</JapaneseText>
      <EnglishText>Até o outro velho, com quem
eu sempre me dava bem,
