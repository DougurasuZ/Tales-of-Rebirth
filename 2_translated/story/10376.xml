  <Strings>
    <Section>s0-0</Section>
    <Entry>
      <PointerOffset>499</PointerOffset>
      <JapaneseText>お待たせ！
ゴミだらけの通路を
掃除したよ！</JapaneseText>
      <EnglishText>Obrigado por esperar!
Limpei todo o lixo
do caminho!</EnglishText>
      <Notes/>
      <SpeakerId>0</SpeakerId>
      <Id>4</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>521</PointerOffset>
      <JapaneseText>これでサニイタウン方面へも
こっちの通路から近道できるよ！</JapaneseText>
      <EnglishText>Agora dá pra usar como
atalho pra Sunnytown!</EnglishText>
      <Notes/>
      <SpeakerId>0</SpeakerId>
      <Id>5</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>546</PointerOffset>
      <JapaneseText>来てみたら、
ゴミだらけでビックリ！</JapaneseText>
      <EnglishText>Fiquei chocado com a
quantidade de lixo!</EnglishText>
      <Notes/>
      <SpeakerId>0</SpeakerId>
      <Id>6</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>568</PointerOffset>
      <JapaneseText>でもボクが来たからにはもう安心！
キレイにしちゃうよ！</JapaneseText>
      <EnglishText>Mas agora que eu cheguei,
não tema! Vou deixar tudo
limpinho rapidinho!</EnglishText>
      <Notes/>
      <SpeakerId>0</SpeakerId>
      <Id>7</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>590</PointerOffset>
      <JapaneseText>もうすぐ、こっちの通路から
サニイタウンの方に
近道できるようになるからね。</JapaneseText>
      <EnglishText>Logo você vai poder ir pra
Sunnytown por este
caminho.</EnglishText>
      <Notes/>
      <SpeakerId>0</SpeakerId>
      <Id>8</Id>
      <Status>Proofreading</Status>
    </Entry>
  </Strings>
