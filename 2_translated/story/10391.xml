  <Strings>
    <Section>s2-1</Section>
    <Entry>
      <PointerOffset>563</PointerOffset>
      <JapaneseText>はぁ……はぁ……
お……父さん……
</JapaneseText>
      <EnglishText>Haah... Haah...
P...Pai...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>37</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>586</PointerOffset>
      <JapaneseText>……助ける……必ず助ける……
バース……力を貸してくれ……
</JapaneseText>
      <EnglishText>...Eu vou te salvar... Com certeza...
Barrs... Me dê forças...</EnglishText>
      <Notes>Ah got it these are party leader specific lines.</Notes>
      <SpeakerId>9</SpeakerId>
      <Id>38</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>628</PointerOffset>
      <JapaneseText>はぁ……はぁ……</JapaneseText>
      <EnglishText>Uuh... Ah...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>39</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>651</PointerOffset>
      <JapaneseText>早くお医者さんを
探さなきゃ！
</JapaneseText>
      <EnglishText>Precisamos correr e achar
um médico pra ela!</EnglishText>
      <Notes/>
      <SpeakerId>9</SpeakerId>
      <Id>40</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>693</PointerOffset>
      <JapaneseText>……ん……んん……</JapaneseText>
      <EnglishText>...Nnh....Ungh...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>41</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>716</PointerOffset>
      <JapaneseText>急いで医者を
連れて来なくては……！</JapaneseText>
      <EnglishText>Precisamos levar um médico
pra ela depressa!</EnglishText>
      <Notes/>
      <SpeakerId>9</SpeakerId>
      <Id>42</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>759</PointerOffset>
      <JapaneseText>……はぁ……ぁんん……</JapaneseText>
      <EnglishText>...Aah... Ughh...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>43</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>782</PointerOffset>
      <JapaneseText>がんばれ、&lt;Annie&gt;！
すぐに医者を連れて来るからな！</JapaneseText>
      <EnglishText>Aguente firme, &lt;Annie&gt;!
Logo voltamos com um
médico!</EnglishText>
      <Notes/>
      <SpeakerId>9</SpeakerId>
      <Id>44</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>825</PointerOffset>
      <JapaneseText>……うぅっ……はぁはぁ……</JapaneseText>
      <EnglishText>...Uughh... Ungh...</EnglishText>
      <Notes/>
      <SpeakerId>1</SpeakerId>
      <Id>45</Id>
      <Status>Proofreading</Status>
    </Entry>
    <Entry>
      <PointerOffset>848</PointerOffset>
      <JapaneseText>&lt;Annie&gt;……
医者を探さなくちゃ……</JapaneseText>
      <EnglishText>&lt;Annie&gt;... Vamos achar
um médico pra você...</EnglishText>
      <Notes/>
      <SpeakerId>9</SpeakerId>
      <Id>46</Id>
      <Status>Proofreading</Status>
    </Entry>
